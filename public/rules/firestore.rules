rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(assistanceId) {
      return request.auth != null && request.auth.uid == assistanceId;
    }

    match /assistances/{assistanceId} {
      allow read, write: if isOwner(assistanceId);

      match /orders/{orderId} {
        allow read, write: if isOwner(assistanceId);
      }
    }
  }
}
